# Copy to .env (git-ignored). EXPO_PUBLIC_* values are inlined into the app; the rest stay on the build machine.
# PostHog (Settings → Project → Project API key; US Cloud host — the region is fixed when the organization is created)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry (Project → Client Keys → DSN; Settings → org and project slugs)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oNNNNNN.ingest.us.sentry.io/NNNNNNN
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=traceroutine
# Only on the build machine / EAS secret, never in the app: source-map upload
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx
